# Environment variables — set these in Vercel Dashboard → Project → Settings → Environment Variables
# Copy this file to `.env` for local development with `vercel dev`.
# DO NOT commit `.env` (it's gitignored).

# Web3Forms access key — get one free at https://web3forms.com
WEB3FORMS_KEY=your-web3forms-access-key

# Admin password (the actual password, in plain text — only stored on Vercel server, never in browser)
ADMIN_PASSWORD=pick-a-strong-password

# Random string used to sign admin session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_TOKEN_SECRET=long-random-hex-string-at-least-64-chars

# Allowed origins (comma-separated) — locks API to your live site only.
# Replace with your real Vercel URL(s) once deployed.
ALLOWED_ORIGINS=https://am-architects.vercel.app,http://localhost:3000
